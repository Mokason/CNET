# Source this file before scripts/run_cnet_ds4_dual.sh.
# No credentials are required; the staged API binds loopback only.

export CNET_DS4_ROOT=/home/marble/AI/ds4
export CNET_DS4_SERVER=/home/marble/AI/ds4/ds4-server
export CNET_DS4_MODEL=/home/marble/AI/ds4/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf

# Preserve llama.cpp on 8081 until the replacement matrix passes.
export CNET_DS4_API_HOST=127.0.0.1
export CNET_DS4_API_PORT=8082
export CNET_DS4_DIST_HOST=127.0.0.1
export CNET_DS4_DIST_PORT=9411

# GPU0 owns 0..20 plus the coordinator/output path; GPU1 owns 21..output.
# Disabling the expanded Q8→F16 cache below supplies the worker's extra room.
export CNET_DS4_LAYER_SPLIT=20
export CNET_DS4_LAYER_AHEAD=2
export CNET_DS4_PREFILL_WINDOW=4
export CNET_DS4_CTX=32768
export CNET_DS4_CACHE_EXPERTS=1GB
# A 2–4 GiB reserve starves the 21:output worker after its f16/range arena is
# resident. One GiB keeps an emergency margin while leaving room for experts.
export CNET_DS4_RESERVE_GB=1
# Avoid 1.75 GiB arena fragmentation on each 32 GiB card. DS4 rounds any
# individual tensor range larger than this up to its required aligned size.
export CNET_DS4_ARENA_CHUNK_MB=512
# Expanded Q8→F16 acceleration consumes ~5.4 GiB per process and prevents a
# complete 24-layer route from fitting. Native Q8 kernels preserve correctness.
export CNET_DS4_NO_Q8_F16_CACHE=1
# Keep decode in the same bounded per-layer range epoch as prefill instead of
# attempting to map every layer's static decode spans at once.
export CNET_DS4_BOUNDED_LAYER_MAP=1
export CNET_DS4_READY_TIMEOUT_SEC=1800

# Refuse GPU oversubscription by default. Set to 1 only for an intentional
# contention experiment, never for replacement acceptance.
export CNET_DS4_ALLOW_SHARED_GPU=0

# The resumable identity action hashes 1 GiB chunks and checkpoints every chunk.
export CNET_HASH_CHUNK_BYTES=1073741824
