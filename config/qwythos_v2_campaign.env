# Qwythos english-window v2 campaign recipe.
# Measured (2026-07-17 margin sweep): CNET_TOPK_SET converts ordered near-ties
# into set claims — predicted 255/256 minable vs 101/256 ordered at eps 0.02.
#
# CRITICAL: set semantics change unit claims → NEW goldens required.
# Do not reuse goldens_qwythos.txt from v1. Do not retcon v1 bases.
#
# Usage (after deploy profile):
#   set -a && . config/cnet-deploy.env && . config/qwythos_v2_campaign.env && set +a
#   make flagship_run_build
#   # then run flagship_run against qwythos with a NEW base path, e.g.
#   #   qwythos_english_v2.cnb  (never overwrite v1)

export CNET_TOPK_SET=1
export CNET_CERT_MARGIN=0.02
# Window/context paths stay the deploy / gap-lane settings.
# Goldens path must be a v2 file once recorded:
# export CNET_GOLDENS=goldens_qwythos_v2.txt
