# ROE / CNET external teacher via Ollama cloud
# Usage (shell):
#   set -a && . config/roe-teacher-ollama-cloud.env && set +a
#   make roe_teacher_cloud_smoke
#   ./bin/roe_asi_cli ask "what is fail-closed" --live --catalog artifacts/roe_catalog
#
# No DEEPSEEK_API_KEY. Requires local Ollama with cloud access and model:
#   ollama show deepseek-v4-flash:cloud
#   (or: ollama pull deepseek-v4-flash:cloud)

ROE_LIVE=1
ROE_LLM=1
ROE_LOOKUP=0
ROE_LLM_URL=http://127.0.0.1:11434/api/generate
ROE_LLM_MODEL=deepseek-v4-flash:cloud
# Cloud V4 flash returns empty response unless think is off for short teacher answers
ROE_LLM_THINK=0
ROE_TIMEOUT_MS=120000
