# Personal AI ops scheduler profile.
# Loaded by scripts/personal_ai_ops_tick.sh and the systemd timer unit.
#
# Shell: set -a && . config/personal-ai-ops.env && set +a

# --- Scope ---
# CNET_BASE_PATH inherited from personal-ai.env when present

# --- Heal (safe defaults) ---
# Low-heat default: report an offline learner but never wake the local teacher
# without an explicit operator start.
OPS_RESTART_LEARNER=0
OPS_REBUILD_GAP_LANE=1
OPS_AUTO_JTC_SEAL=1
# Hermes gateway restart is opt-in (visible to chat clients)
OPS_RESTART_HERMES=0

# --- Learn / escalate ---
# External/cloud diagnosis is opt-in; scheduled ticks must stay local unless
# the operator explicitly grants that egress for this channel.
OPS_ASK_HERMES=0
OPS_HERMES_MAX_TURNS=4
OPS_HERMES_TIMEOUT_SEC=180
# Append Hermes answers under logs/personal_ai_ops/lessons/
OPS_STORE_LESSONS=1
# Seed a JTC gap when Hermes suggests a new tool name not in the closed set
OPS_NOTE_JTC_GAP_ON_UNKNOWN=1

# --- TODO queue ---
# JSONL: {"ts":"...","id":"...","status":"open|done","text":"...","priority":1}
OPS_TODO_FILE=
# max open todos processed per tick
OPS_TODO_MAX=2

# --- Cadence (timer uses its own OnUnitActiveSec; this is soft throttle) ---
OPS_MIN_INTERVAL_SEC=300

# --- Stale curriculum (planner → teachable learn queue) ---
# Disabled by default: this host has no permitted local Ollama endpoint. Re-enable
# only with an explicitly configured cloud/Hermes backend and credentials.
# The planner never writes certified units; it only seeds lookup/TODO work.
OPS_CURRICULUM_ON_STALE=0
OPS_CURRICULUM_BACKEND=hermes
OPS_CURRICULUM_MODEL=
OPS_CURRICULUM_MODEL_FALLBACK=
OPS_CURRICULUM_TIMEOUT_SEC=120
OPS_STALE_NO_GROWTH_SEC=2700
OPS_CURRICULUM_MAX_PER_HOUR=2
OPS_CURRICULUM_MAX_ITEMS=3

# --- Pattern runtime (fluid → freeze callouts) ---
OPS_PATTERN_PROMOTE=1
# Import certified CNB units as frozen UNIT edges (needs cnet.so + base)
OPS_PATTERN_IMPORT_UNITS=0
OPS_PATTERN_IMPORT_MAX=32
