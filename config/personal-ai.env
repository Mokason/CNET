# Personal AI deploy profile: local library first; big AI only on call.
#
# Shell:   set -a && . config/personal-ai.env && set +a
# systemd: EnvironmentFile=.../config/personal-ai.env  (no "export" keywords)
#
# Does not lower certification bars.

# --- Free wins ---
CNET_ORACLE_INT8=1
CNET_TRAIN_FAST=1
CNET_ACQ_STAGES=40
CNET_ACQ_ADAPTIVE=1
CNET_GGUF_MMAP=1
CNET_LANE_PROBE_BATCH=32
OMP_NUM_THREADS=4

# --- Local library first (hybrid A/B/C) ---
CNET_PERSONAL_ALLOW_TEACHER=1
CNET_PERSONAL_ALLOW_SOFT=1
CNET_PERSONAL_ALLOW_RESIDUAL=1
# 0 = teacher answers miss; gap lane teaches later (low latency)
CNET_PERSONAL_TEACH_INLINE=0
CNET_PERSONAL_MAX_INLINE_TEACHES=0
CNET_PERSONAL_STRUCTURE_MIN_HITS=3

# --- Real Tier C residual (local GGUF open-ended) ---
# Verified 2026-07-17: make residual_gguf_real → RESIDUAL_GGUF_PASS checks=9
# personal_ai_open auto-binds when set (fail-closed if path unreadable).
# Learner (gap_lane_run) ignores these; residual is for personal_ai serve/mine.
# Prefer Bonsai HTTP residual (1-bit, low RAM). GGUF kept as offline fallback.
CNET_RESIDUAL_HTTP=http://127.0.0.1:8080
CNET_RESIDUAL_WINDOW=/home/marble/AI/CNET/english_window_256_bonsai.txt
# CNET_RESIDUAL_GGUF=/home/marble/AI/Models/gemma4-v2-Q4_K_M.gguf
# CNET_RESIDUAL_WINDOW=/home/marble/AI/CNET/english_window_256.txt
CNET_ORACLE_INT8=1

# --- Colibrì follow-through (D) ---
# LFRU residency on forest rehydrate (production-safe opt-in).
CNET_FOREST_LFRU=1
# PILOT: record next residual slots; structure-mine consumes order (research).
CNET_PILOT=1
# Session KV for multi-turn residual chat only — keep OFF for bit-stable mines.
# CNET_RESIDUAL_SESSION_KV=1

# --- Learning aggression (B) ---
CNET_PERSONAL_STRUCTURE_MIN_HITS=2
# Optional: mine residual traces on every residual serve (heavier).
# CNET_PERSONAL_STRUCTURE_MINE_ON_SERVE=1

# --- Curiosity (self-started teachable gaps when idle) ---
# Proposes w_cur → tk{id}q{id} top-k for under-covered window tokens.
# With CNET_AUTO_LEARN_FREEFORM=0, tk* curiosity only fills waiting_oracle sludge
# (no freeform rewrite path). Keep OFF unless intentionally mining window tokens.
CNET_CURIOSITY=0
CNET_CURIOSITY_MAX_PER_HOUR=6
CNET_CURIOSITY_MAX_PER_TICK=1
CNET_CURIOSITY_K=3
CNET_CURIOSITY_YIELD_OPEN=1
# CNET_CURIOSITY_STATE=/path/to/base.curiosity  (default: <base>.curiosity)

# --- Local EG / hill-climb (MAI-inspired) ---
# baseline examined-per-seal for local_eg = baseline / cost_per_seal
CNET_EG_BASELINE_COST=32
# CNET_EG_LOG=/path/to/base.hill_climb.jsonl

# --- Voice external teacher (optional; multimodal subprocess ABI) ---
# Hermetic gate: tools/voice_teacher.py --mode hermetic
# Real ASR:    prefer Hermes venv when faster-whisper is installed
# CNET_VOICE_TEACHER_CMD=python3 tools/voice_teacher.py --mode hermetic
# CNET_VOICE_TEACHER_CMD=/home/marble/.hermes/hermes-agent/venv/bin/python3 tools/voice_teacher.py --mode whisper --model tiny

# --- Budgeted self-improve ---
CNET_LANE_MAX_CLOSURES=4
CNET_TEACHER_IDLE_SEC=300
CNET_LANE_INTERVAL_SEC=120
CNET_HEALTH_TICK_SECONDS=300

# --- Oracle teacher + gap economics (2026-07-21) ---
# Keep attestation OFF until teachers stamp full SHA+toolchain in this profile.
CNET_ORACLE_REQUIRE_ATTESTED=0
CNET_ORACLE_V2_ONLY_NEW=0
CNET_ORACLE_REQUIRE_LEASE=0
CNET_ORACLE_RETIRE_UNFIT_RATE=0.5
CNET_ORACLE_RETIRE_MIN_CALLS=32
# Prefer mining demand over curiosity when many opens
# (curiosity itself is off under freeform-off; keep tight if re-enabled)
CNET_CURIOSITY_YIELD_OPEN=1
# Structure-mine residual traces during serve (Tier C → A)
CNET_PERSONAL_STRUCTURE_MINE_ON_SERVE=1

# --- Automatic learn-from-Hermes (2026-07-21) ---
# Freeform capability misses rewrite to window-teachable tk*q* shapes.
CNET_AUTO_LEARN=1
CNET_AUTO_LEARN_W=256
CNET_AUTO_LEARN_K=3
# Faster drain + more seals per tick while chatting
CNET_LANE_INTERVAL_SEC=60
CNET_LANE_MAX_CLOSURES=8

# G1 janitor (systemd timer 03:30)
# CNET_JANITOR_NOTE_LOW_REL=1

# Soft residual without binding second GGUF in MCP
# Hermetic stays as last-resort; HTTP residual wins when CNET_RESIDUAL_HTTP set.
CNET_SOUL_RESIDUAL_HERMETIC=1
CNET_JTC_MIN_CONF=0.20
# CNET_CHARTER_ENFORCE=0

CNET_SOUL_RESIDUAL_PREFER_HERMETIC=0

# --- Fault bus + PEFT durability (2026-07-24 P0) ---
# Cross-process labeled faults → registry_lora_tick ingest/teach/certify.
CNET_FAULT_LOG=/home/marble/AI/CNET/logs/cnet_faults.jsonl
# Mirror labeled pairs from registry_supply_label (1=on, 0=off)
CNET_FAULT_MIRROR=1
# Freeform tk* rewrite OFF (structured skill_/research_/chunk_ only)
CNET_AUTO_LEARN_FREEFORM=0
# Persist certified adapters next to base
CNET_LORA_STORE_DIR=/home/marble/AI/CNET/logs/lora_store
CNET_LORA_STORE_AUTOSAVE=1
CNET_LORA_STORE_AUTOLOAD=1
# Optional promote gate reading ghost-eval delta file
# CNET_PROMOTE=1
# CNET_PROMOTE_EVAL_DELTA=/home/marble/AI/CNET/logs/ghost_eval_delta.txt

# Open-lab import accounting (JSONL)
CNET_ACCT_LOG=/home/marble/AI/CNET/logs/cnet_acct.jsonl
# MoE adapter bank on cert (select at hard-route serve)
CNET_ADAPTER_BANK=1

# Residual confidence floor (0=off)
# CNET_RESIDUAL_MIN_MARGIN=0.02
CNET_LORA_AUTO_ORCH=1
