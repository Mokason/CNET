# Personal AI deploy profile: local library first; big AI only on call.
#
# Shell:   set -a && . config/personal-ai.env && set +a
# systemd: EnvironmentFile=.../config/personal-ai.env  (no "export" keywords)
#
# Does not lower certification bars.

# --- Free wins ---
CNET_ORACLE_INT8=1
CNET_TRAIN_FAST=1
CNET_ACQ_STAGES=40
CNET_ACQ_ADAPTIVE=1
CNET_GGUF_MMAP=1
CNET_LANE_PROBE_BATCH=32
OMP_NUM_THREADS=4

# --- Local library first ---
CNET_PERSONAL_ALLOW_TEACHER=1
# 0 = teacher answers miss; gap lane teaches later (low latency)
CNET_PERSONAL_TEACH_INLINE=0
CNET_PERSONAL_MAX_INLINE_TEACHES=0

# --- Budgeted self-improve ---
CNET_LANE_MAX_CLOSURES=4
CNET_TEACHER_IDLE_SEC=300
CNET_LANE_INTERVAL_SEC=120
CNET_HEALTH_TICK_SECONDS=300
