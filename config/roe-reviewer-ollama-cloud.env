# ROE / CNET external REVIEWER via Ollama cloud (separate from teacher)
#
# Teacher proposes. Reviewer gates promote. Never the same role in one step.
#
# Usage:
#   set -a && . config/roe-teacher-ollama-cloud.env && . config/roe-reviewer-ollama-cloud.env && set +a
#   make roe_reviewer_smoke
#   ROE_EVOLVE_REVIEWER=1 python3 tools/roe_evolve_tick.py
#
# No DEEPSEEK_API_KEY — Ollama cloud models only.

# Enable reviewer for evolve tick (1=on)
ROE_EVOLVE_REVIEWER=1

# Separate model/url knobs (defaults to teacher URL if unset)
ROE_REVIEW_URL=http://127.0.0.1:11434/api/generate
# Prefer a different model when available; same cloud flash is OK if only one
# is pulled — role separation is still enforced by prompt + logs.
ROE_REVIEW_MODEL=deepseek-v4-flash:cloud
ROE_REVIEW_THINK=0
ROE_REVIEW_TIMEOUT_MS=120000

# Fail closed: if reviewer unreachable, do NOT promote (unless gold_file)
ROE_REVIEW_FAIL_CLOSED=1
