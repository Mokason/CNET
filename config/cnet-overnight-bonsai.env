# Overnight CORE — Bonsai only (no MAX, Grok off)
#   set -a && . config/cnet-overnight-bonsai.env && set +a
#   ./bin/cnetd

CNET_GGUF_MMAP=1
CNET_BONSAI_GGUF=/home/marble/AI/Models/Bonsai-8B-gguf/Bonsai-8B.gguf
CNET_CORE_BUS_BRICKS_DIR=${CNET_CORE_BUS_BRICKS_DIR:-$HOME/.local/share/cnet-bricks}
CNET_CORE_AUTO_EVOLVE=1
CNET_CORE_EVOLVE_EVERY=4
CNET_CORE_EVOLVE_BIN=/home/marble/AI/CNET/bin/cnet_core_evolve
CNET_CORE_EVOLVE_FACTORY=1
CNET_PACKS_ROOT=/home/marble/AI/CNET/artifacts/roe_daily_packs

# Residual = Bonsai GPU :8081 only (not MAX :8000)
CNET_HELD_MODEL_ENDPOINT=http://127.0.0.1:8081/v1/chat/completions
CNET_HELD_MODEL_NAME=held
CNET_RESIDUAL_HTTP=http://127.0.0.1:8081

# Grok guide OFF for overnight
CNET_GROK_GUIDE=0

# Obsidian optional (structured only) — leave vault if you want harvest
# CNET_OBSIDIAN_VAULT=/home/marble/Obsidian
