# CNET deploy profile — measured free wins + budgeted self-improve.
# Source before gap_lane / SoulHost / MCP:
#   set -a && . config/cnet-deploy.env && set +a
# Or: scripts/apply_deploy_profile.sh
#
# Does NOT start services. Does NOT lower certification bars.
# TOPK_SET is opt-in via config/qwythos_v2_campaign.env (new goldens required).

# --- Teacher memory diet (measured ~48G f32 → ~20G int8 for 12B) ---
export CNET_ORACLE_INT8=1
export CNET_GGUF_MMAP=1
export CNET_MAX_CTX=128
export CNET_LOAD_TRACE=1

# --- Teaching throughput (byte-identical when TRAIN_FAST on plain SGD) ---
export CNET_TRAIN_FAST=1
export CNET_ACQ_STAGES=40
export CNET_ACQ_ADAPTIVE=1
export CNET_LANE_PROBE_BATCH=32
export OMP_NUM_THREADS=4

# --- Student structure (campaign recipe; exactness bar unchanged) ---
export CNET_ACQ_HIDDEN=128
export CNET_ACQ_MAXHIDDEN=512
export CNET_ACQ_EPOCHS=20000
export CNET_ACQ_TARGET_LOSS=1e-7
export CNET_ACQ_MIN_IMPROVEMENT=1e-9

# --- Budgeted self-improve (CNB-primary serve; sleeping teacher) ---
export CNET_LANE_MAX_CLOSURES=4
export CNET_TEACHER_IDLE_SEC=300
export CNET_LANE_INTERVAL_SEC=120

# --- Health maintenance (opt-in timer; 0 disables) ---
export CNET_HEALTH_TICK_SECONDS=300

# --- Optional: counterfactual ORDER_ONLY among certified peers ---
# export CNET_CF_ORDER=1
# export CNET_COUNTERFACTUAL=1

# --- Optional: sparse KV inference (fail-loud on unwired paths) ---
# export CNET_SPARSE_KV=0.25

# Resource governor ceilings (0 = unlimited). Tighten for co-tenant hosts.
# export CNET_GOV_RAM_BYTES=0
# export CNET_GOV_VRAM_BYTES=0
