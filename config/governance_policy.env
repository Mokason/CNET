# CNET governance policy (human-edited constitution)
# Janitor/lane must stay inside these bounds.
# Env CNET_GOV_* overlays win over this file.
version=1
max_units=2000
warn_units=800
low_rel_floor=0.55
low_rel_min_evidence=64
note_low_rel=1
# Snapshot pins are large (~CNB size). Default off for routine ticks;
# nightly timer can set CNET_GOV_SNAPSHOT=1.
snapshot_on_run=0
max_snapshots=3
refuse_if_stop=1
refuse_over_cap=0
max_waiting_oracle_warn=64
pin_dir=artifacts/janitor/pins
# G3 consolidate (dense acq_tk* buckets)
# keep_per_bucket=48
# bucket_min=32
