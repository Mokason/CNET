# CNET residual held-model teacher via Modular MAX (OPTIONAL).
# Default open-chat residual is Bonsai GPU — see config/cnet-bonsai-held.env
#
# Source only when you want MAX instead of Bonsai:
#   set -a && . config/cnet-max-held.env && set +a
#
# Law: residual teacher only — never auto-CERT, never voice as CNET mouth
# (CNET_NEVER_VOICE_LLM=1). Does NOT replace the pinned Bonsai compete
# baseline macros; this only swaps CNET_HELD_MODEL_* for held_model_v1.
#
# AMD gfx1201 note: bfloat16 GPU kernels produce garbage; use float32.

# --- MAX serve process (scripts/run_cnet_max_held.sh) ---
CNET_MAX_HOST=127.0.0.1
CNET_MAX_PORT=8000
CNET_MAX_PIXI_PROJECT=/home/marble/modular-max-nightly
CNET_MAX_MODEL=Qwen/Qwen2.5-7B-Instruct
CNET_MAX_DEVICES=gpu:0
CNET_MAX_QUANT=float32
CNET_MAX_MAX_LENGTH=4096
CNET_MAX_MAX_BATCH=4
CNET_MAX_NO_DEVICE_GRAPH=1
CNET_MAX_STATE_DIR=/home/marble/.local/state/cnet-max-held

# --- CNET held_model_v1 HTTP hop (MAX) ---
CNET_HELD_MODEL_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
CNET_HELD_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# CNET_HELD_MODEL_PATH=

CNET_CORE_OPEN_CHAT=1
CNET_HEMI_RESIDUAL=1
CNET_NEVER_VOICE_LLM=1
CNET_LOGIC_OPEN_CHAT_FALLBACK=0

# HF_TOKEN=
