# CNET default OPEN_CHAT / held residual — Ternary Bonsai 27B on GPU (:8081)
#
# Source before cnetd / grow / hemi open-chat:
#   set -a && . config/cnet-bonsai-held.env && set +a
#
# Law:
#   - OPEN_CHAT plane only (creativity-strong drafts)
#   - never auto-CERT, never default voice as CNET mouth
#   - CORE middle still prefers CERT for logic
#
# Weights: PQ2_0 (HIP). Legacy Downloads/...-Q2_0.gguf is g128-as-id-42 and
# will not load on Prism b10660. Same 27B; different GGUF layout.
# Serve:   bonsai-compete-rocm.service → 127.0.0.1:8081
# Runtime: /home/marble/AI/llama.cpp-prism/llama-prism-b10660-e311ed3/llama-server

CNET_HELD_MODEL_ENDPOINT=http://127.0.0.1:8081/v1/chat/completions
CNET_HELD_MODEL_NAME=held
# Prefer HTTP residual; do not set PATH unless testing in-process plugin
# CNET_HELD_MODEL_PATH=

CNET_BONSAI_GGUF=/home/marble/AI/Models/Ternary-Bonsai-27B-gguf/Ternary-Bonsai-27B-PQ2_0.gguf

# CORE open-chat plane (product mouth for chat; claimed_cert=0)
CNET_CORE_OPEN_CHAT=1
CNET_HEMI_RESIDUAL=1
CNET_STAGE_RESIDUAL=1
CNET_STAGE_HTTP=http://127.0.0.1:8081
CNET_STAGE_MODEL=held
CNET_OPEN_CHAT_MAY_VOICE=1
CNET_STAGE_MAY_VOICE=1
# pure LOGIC miss may still use open chat when fallback=1 (cnetd unit may override)
CNET_LOGIC_OPEN_CHAT_FALLBACK=1

CNET_RESIDUAL_HTTP=http://127.0.0.1:8081
