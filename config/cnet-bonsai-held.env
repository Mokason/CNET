# CNET default OPEN_CHAT / held residual — Bonsai-8B on GPU (:8081)
#
# Source before cnetd / grow / hemi open-chat:
#   set -a && . config/cnet-bonsai-held.env && set +a
#
# Law:
#   - OPEN_CHAT plane only (creativity-strong drafts)
#   - never auto-CERT, never default voice as CNET mouth
#   - CORE middle still prefers CERT for logic
#
# This is the DEFAULT residual teacher. MAX is optional — see
# config/cnet-max-held.env and plans/cnet_max_held_mojo.md

# Bonsai GPU compete/residual server (ROCm llama-server -ngl 99)
CNET_HELD_MODEL_ENDPOINT=http://127.0.0.1:8081/v1/chat/completions
# llama.cpp accepts placeholder "held"; path alias also works
CNET_HELD_MODEL_NAME=held
# Leave PATH unset so HTTP is preferred over GGUF plugin
# CNET_HELD_MODEL_PATH=

# CORE open-chat plane
CNET_CORE_OPEN_CHAT=1
CNET_HEMI_RESIDUAL=1
CNET_NEVER_VOICE_LLM=1
# pure LOGIC miss does not invent creative fill
CNET_LOGIC_OPEN_CHAT_FALLBACK=0

# personal_ai Tier-C residual (window one-hot) — GPU bonsai preferred
CNET_RESIDUAL_HTTP=http://127.0.0.1:8081
# CNET_RESIDUAL_WINDOW stays in personal-ai.env if set

# OPEN_CHAT leftover answers killed (product law)
CNET_CORE_OPEN_CHAT=0
CNET_HEMI_RESIDUAL=0
