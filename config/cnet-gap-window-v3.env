# SUPERSEDED 2026-08-17 — use config/cnet-gap-window-v4.env.
#
# Kept for provenance; do NOT source this file. Two reasons:
#   1. The window below is largely consumed. v4 is the live window.
#   2. The teacher/residual lines pin :8080, the CPU llama-server (-ngl 0).
#      Measured on the real teach shape (unique ~128-token prompts, cold
#      prefill), :8080 costs 1727 ms per request against 115 ms on the GPU
#      server :8081 — ~15x. The live services now pin :8081 via the
#      zz-teacher-8081 systemd drop-in, which also reconciles with
#      config/personal-ai.env:32 (already :8081).
# A window env should never have pinned an endpoint at all; v4 sets the window
# and nothing else.
#
# Gap-lane / autoteach window — Bonsai 256 v3 (post-exhaustion mint)
CNET_WINDOW_FILE=/home/marble/AI/CNET/english_window_256_bonsai_v3.txt
CNET_RESIDUAL_WINDOW=/home/marble/AI/CNET/english_window_256_bonsai_v3.txt
CNET_TEACHER_HTTP=http://127.0.0.1:8080
CNET_RESIDUAL_HTTP=http://127.0.0.1:8080
