[Unit]
Description=CNET Gap Lane - 24/7 knowledge acquisition (detect, teach from local model, persist)
Documentation=file:///home/marble/AI/CNET/include/gap_lane.h
# Fail-safe: if the daemon binary is absent (e.g. not yet built, or this host
# is a non-CNET worker) the unit is cleanly skipped via ConditionFileIsExecutable
# instead of producing 203/EXEC restart churn.  The condition must match the
# executable at the start of ExecStart below.
ConditionFileIsExecutable=/home/marble/AI/CNET/bin/gap_lane_run

[Service]
Type=simple
WorkingDirectory=/home/marble/AI/CNET
# inbox must match the serving side (CNET_GAP_INBOX in the MCP launch.sh)
Environment=CNET_GAP_INBOX=/home/marble/AI/CNET/soul_gemma4v2_final.cnb.inbox
# memory diet: mmap-backed weights (reclaimable page cache, not anon RSS)
# and a tiny KV cap — the lane teaches from 1-token contexts
# int8-on-load IS the diet: default load dequantizes to f32 (~48G for 12B)
Environment=CNET_ORACLE_INT8=1
Environment=CNET_LOAD_TRACE=1
Environment=CNET_GGUF_MMAP=1
Environment=CNET_MAX_CTX=128
# teaching window base: [base, base+W) — token ids 0..255 are special tokens
# with flat logits (every point abstains as a near-tie); real-token ranges
# carry signal
# corpus-drawn teaching: the window maps one-hots to real English token ids
# (the campaign's english window); the context pins a real tokenized prose
# prefix in the KV once, and every teaching call probes prefix+token.
Environment=CNET_WINDOW_FILE=/home/marble/AI/CNET/english_window_256.txt
Environment=CNET_LANE_CONTEXT_FILE=/home/marble/AI/CNET/config/lane_context_english_v1.ids
# named contexts: goal tag "<name>_..." teaches under lane_contexts/<name>.ids
# (lamp = evening reading prose, storm = storm at sea); unmatched tags use the
# default context above. The teacher re-pins the KV on context switch.
Environment=CNET_LANE_CONTEXT_DIR=/home/marble/AI/CNET/config/lane_contexts
Environment=CNET_LANE_TOKEN_BASE=1000
# near-tie abstention margin on raw logits: 1e-4 abstains >10% of a
# restricted window (oracle_unfit); 1e-6 declines only genuine ties
# real contexts have real margins: abstain only on genuine ties
Environment=CNET_LANE_MARGIN_EPS=1e-6
# student structure budget: the campaign's 100%-yield recipe for
# 256-window units (README quickstart) — defaults (8->64, 4k epochs)
# plateau below exact replay on this shape (certify_failed)
Environment=CNET_ACQ_HIDDEN=128
Environment=CNET_ACQ_MAXHIDDEN=512
Environment=CNET_ACQ_EPOCHS=20000
# exactness bar: average-loss 1e-4 leaves one stubborn point wrong on
# near-constant maps (certify 255/256); 1e-7 trains through it. ADAPTIVE
# checks exactness between stages and stops the moment the student is exact
Environment=CNET_ACQ_TARGET_LOSS=1e-7
Environment=CNET_ACQ_MIN_IMPROVEMENT=1e-9
Environment=CNET_ACQ_ADAPTIVE=1
Environment=CNET_LANE_INTERVAL_SEC=120
Environment=CNET_LANE_LOW_REL=0.55
Environment=CNET_LANE_LOW_REL_MIN_EV=64
ExecStart=/home/marble/AI/CNET/bin/gap_lane_run \
    /home/marble/AI/CNET/soul_gemma4v2_final.cnb \
    /home/marble/AI/CNET/soul_gemma4v2_final.cnb.gaps.txt \
    /home/marble/AI/Models/gemma4-v2-Q4_K_M.gguf
# CPU-only background citizen: both R9700s stay reserved
Nice=19
CPUWeight=20
MemoryHigh=24G
MemoryMax=28G
# stop file (<base>.stop) exits 0 and must NOT be restarted into
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
