{
  "schema": 1,
  "pass": 2,
  "rows": [
    {
      "id": "r002",
      "text": "Please apply upper case to the quoted punctuation character ';'."
    },
    {
      "id": "r003",
      "text": "I'd like ! converted to uppercase."
    },
    {
      "id": "r005",
      "text": "Could you uppercase the character 'k?"
    },
    {
      "id": "r006",
      "text": "For the letter r, please give its uppercase form."
    },
    {
      "id": "r026",
      "text": "For the letter A, I'd like its lowercase form."
    },
    {
      "id": "r035",
      "text": "For the input scalar U+1F642, please apply upper case."
    },
    {
      "id": "r038",
      "text": "\"Would you put a into uppercase, please?\""
    },
    {
      "id": "r044",
      "text": "Could you make the scalar U+0100 uppercase, please?"
    },
    {
      "id": "r069",
      "text": "For this case conversion, make 7 uppercase."
    },
    {
      "id": "r091",
      "text": "I'd like an uppercase conversion of the literal character '!'."
    },
    {
      "id": "r092",
      "text": "Use Turkish-specific case conversion to uppercase the letter i."
    },
    {
      "id": "r093",
      "text": "Could you show q in capital-letter form for me?"
    },
    {
      "id": "r096",
      "text": "Please apply lowercase to # for me."
    }
  ],
