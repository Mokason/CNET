[Unit]
Description=Local CNET capture operational alert
# Notification frequency is bounded by durable helper state. Manager start
# limiting rejects valid repeated OnFailure triggers and leaves a false failure.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=%h/.config/cnet/venv-discord/bin/python %h/.local/share/cnet-discord-capture/releases/@RELEASE@/alert.py %h/.local/share/cnet-discord-capture/alerts
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=12
UMask=0077
NoNewPrivileges=yes
