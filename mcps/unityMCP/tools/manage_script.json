{
  "name": "manage_script",
  "description": "Compatibility router for legacy script operations. Prefer apply_text_edits (ranges) or script_apply_edits (structured) for edits.",
  "inputSchema": {
    "properties": {
      "action": {
        "description": "Perform CRUD operations on C# scripts.",
        "enum": [
          "create",
          "read",
          "delete"
        ],
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "contents": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "script_type": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "namespace": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "action",
      "name",
      "path"
    ],
    "type": "object"
  }
}