[Unit]
Description=CNET ROE unattended evolve tick (miss→policy promote→pack_personal)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/AI/CNET
Environment=ROE_EVOLVE_STABLE_N=3
Environment=ROE_EVOLVE_MAX_PROMOTES=20
Environment=ROE_EVOLVE_TEACHER=0
# Separate reviewer gate (Ollama). gold_file still skips reviewer.
Environment=ROE_EVOLVE_REVIEWER=1
EnvironmentFile=-%h/AI/CNET/config/roe-reviewer-ollama-cloud.env
EnvironmentFile=-%h/AI/CNET/config/roe-teacher-ollama-cloud.env
ExecStart=/usr/bin/python3 %h/AI/CNET/tools/roe_evolve_tick.py
Nice=10

[Install]
WantedBy=default.target
