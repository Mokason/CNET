[Unit]
Description=CNET ROE unattended evolve tick (miss→policy promote→pack_personal)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/AI/CNET
Environment=ROE_EVOLVE_STABLE_N=3
Environment=ROE_EVOLVE_MAX_PROMOTES=20
# Teacher fill optional; leave 0 for gold/multi_stable only
Environment=ROE_EVOLVE_TEACHER=0
ExecStart=/usr/bin/python3 %h/AI/CNET/tools/roe_evolve_tick.py
Nice=10

[Install]
WantedBy=default.target
