[Unit]
Description=CNET web cockpit (Tailscale/localhost → cnetd socket)
After=cnetd.service
Wants=cnetd.service

[Service]
Type=simple
WorkingDirectory=%h/AI/CNET
EnvironmentFile=-%h/.local/share/cnet-minimal/cnet-minimal.env
Environment=CNET_MINIMAL_ROOT=%h/.local/share/cnet-minimal/current
Environment=CNET_PACKS_ROOT=%h/.local/share/cnet-minimal/current/data/roe_daily_packs
Environment=CNET_WEB_PORT=8642
# Host auto: tailscale 100.x or 127.0.0.1 — override with CNET_WEB_HOST
ExecStart=/usr/bin/python3 %h/AI/CNET/tools/cnet_web.py
Restart=on-failure
RestartSec=3
Nice=8

[Install]
WantedBy=cnet-marble.target
