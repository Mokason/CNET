<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>CNET.Cce</RootNamespace>
    <AssemblyName>CNET.Cce</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The native cce.dll / cce.so must be discoverable at runtime.
         Place it next to your app, or in the output directory.
         For development, the test/benchmark projects below will try to copy it. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude example code from the main library -->
    <Compile Remove="Examples\**" />
    <EmbeddedResource Remove="Examples\**" />
    <None Remove="Examples\**" />
    <!-- Dead raw-Port/Contract bindings (reference non-exported symbols / mis-scoped
         marshalling types). The soul_host shim (SoulHost.cs) supersedes them. -->
    <Compile Remove="CceContract.cs" />
    <Compile Remove="CceRegistry.cs" />
    <Compile Remove="CceRouter.cs" />
    <Compile Remove="CceSupra.cs" />
    <Compile Remove="CcePerceptual.cs" />
  </ItemGroup>

</Project>
