<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>CNET.Cce</RootNamespace>
    <AssemblyName>CNET.Cce</AssemblyName>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML documentation is published incrementally; missing-doc warnings are
         excluded so every remaining compiler/analyzer warning is release-fatal. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The native cce.dll / cce.so must be discoverable at runtime.
         Place it next to your app, or in the output directory.
         For development, the test/benchmark projects below will try to copy it. -->
    <InternalsVisibleTo Include="CNET.Cce.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude example code from the main library -->
    <Compile Remove="Examples\**" />
    <EmbeddedResource Remove="Examples\**" />
    <None Remove="Examples\**" />
    <!-- Dead raw-Port/Contract/Supra bindings reference non-exported symbols or
         unsafe guessed layouts. Live router/perceptual bindings remain compiled. -->
    <Compile Remove="CceContract.cs" />
    <Compile Remove="CceRegistry.cs" />
    <Compile Remove="CceSupra.cs" />
  </ItemGroup>

</Project>
