<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>CNET.Cce</RootNamespace>
    <AssemblyName>CNET.Cce</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The native cce.dll / cce.so must be discoverable at runtime.
         Place it next to your app, or in the output directory.
         For development, the test/benchmark projects below will try to copy it. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude example code from the main library -->
    <Compile Remove="Examples\**" />
    <EmbeddedResource Remove="Examples\**" />
    <None Remove="Examples\**" />
  </ItemGroup>

</Project>
