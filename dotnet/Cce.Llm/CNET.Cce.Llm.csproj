<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LibraryImport source generator (cnet.so auto-learn binding) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CNET.Cce.Llm</RootNamespace>
    <AssemblyName>CNET.Cce.Llm</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- GPL-3.0-only, not Apache-2.0 like CNET.Cce: this assembly links against
         the vendored CNET.Llm engine. Keeping the bridge in its own assembly is
         what stops that obligation from reaching CNET.Cce itself. -->
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- Deliberately NOT IsAotCompatible: CNET.Cce sets IsAotCompatible=true and
         must stay that way. The LLM engine is not part of that guarantee, so the
         bridge does not claim it. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cce\Cce.csproj" />
    <ProjectReference Include="..\Llm\src\CNET.Llm.Engine\CNET.Llm.Engine.csproj" />
    <ProjectReference Include="..\Llm\src\CNET.Llm.Models\CNET.Llm.Models.csproj" />
    <ProjectReference Include="..\Llm\src\CNET.Llm.Tokenizers\CNET.Llm.Tokenizers.csproj" />
    <ProjectReference Include="..\Llm\src\CNET.Llm.Cpu\CNET.Llm.Cpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CNET.Cce.Llm.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn parses the host-side policy guard; compilation/execution is
         confined to the separately packaged OS sandbox worker. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <ProjectReference Include="../Cce.Scriptlet.Worker/CNET.Scriptlet.Worker.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="../Cce.Scriptlet.Worker/bin/$(Configuration)/net10.0/scriptlet-worker.sha256" LogicalName="ScriptletWorker.sha256" />
    <Content Include="../Cce.Scriptlet.Worker/bin/$(Configuration)/net10.0/CNET.Scriptlet.Worker.dll;../Cce.Scriptlet.Worker/bin/$(Configuration)/net10.0/CNET.Scriptlet.Worker.deps.json;../Cce.Scriptlet.Worker/bin/$(Configuration)/net10.0/CNET.Scriptlet.Worker.runtimeconfig.json;../Cce.Scriptlet.Worker/bin/$(Configuration)/net10.0/Microsoft.CodeAnalysis.dll;../Cce.Scriptlet.Worker/bin/$(Configuration)/net10.0/Microsoft.CodeAnalysis.CSharp.dll;../Cce.Scriptlet.Worker/bin/$(Configuration)/net10.0/cnet-scriptlet-launcher;../Cce.Scriptlet.Worker/bin/$(Configuration)/net10.0/libcnet-scriptlet-seal.so"
             Link="ScriptletWorker/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
