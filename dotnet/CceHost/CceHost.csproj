<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>CNET.CceHost</RootNamespace>
    <AssemblyName>CceHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cce\Cce.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the CNET certified engine native lib must sit next to the app -->
    <None Include="..\..\cnet.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\cnet.so')" />
  </ItemGroup>
</Project>
