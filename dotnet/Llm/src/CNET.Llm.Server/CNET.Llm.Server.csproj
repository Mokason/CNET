<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Library, not Exe. CNET.Llm.Server is consumed in-process by CNET.Llm.Cli's serve
         command and by any consumer app that wants to host the OpenAI-compatible API
         inside its own ASP.NET Core process. The Microsoft.NET.Sdk.Web SDK is kept
         for the WebApplication / endpoint types. -->
    <OutputType>Library</OutputType>
    <!-- Microsoft.NET.Sdk.Web defaults IsPackable=false regardless of OutputType.
         Force it on so consumers can reference this library from their own ASP.NET hosts. -->
    <IsPackable>true</IsPackable>
    <Description>OpenAI-compatible HTTP API server for CNET LLM — /v1/chat/completions, /v1/completions, streaming, tool calling, and a built-in chat UI. Reference this package to host the API inside your own ASP.NET Core app.</Description>
    <!-- DTOs are self-documenting via [JsonPropertyName] attributes -->
    <!-- IL2026: MapGet/MapPost use reflection at build time but Request Delegate Generator
         handles them at publish time when PublishAot=true -->
    <NoWarn>CS1591;IL2026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CNET.Llm.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html" />
    <EmbeddedResource Include="wwwroot\app.js" />
    <EmbeddedResource Include="wwwroot\app.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CNET.Llm.Core\CNET.Llm.Core.csproj" />
    <ProjectReference Include="..\CNET.Llm.Engine\CNET.Llm.Engine.csproj" />
    <ProjectReference Include="..\CNET.Llm.Models\CNET.Llm.Models.csproj" />
    <ProjectReference Include="..\CNET.Llm.Tokenizers\CNET.Llm.Tokenizers.csproj" />
    <ProjectReference Include="..\CNET.Llm.Cpu\CNET.Llm.Cpu.csproj" />
    <ProjectReference Include="..\CNET.Llm.Cuda\CNET.Llm.Cuda.csproj" />
    <ProjectReference Include="..\CNET.Llm.HuggingFace\CNET.Llm.HuggingFace.csproj" />
    <ProjectReference Include="..\CNET.Llm.Telemetry\CNET.Llm.Telemetry.csproj" />
  </ItemGroup>


</Project>
